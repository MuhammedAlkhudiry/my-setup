{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "printWidth": 150,
        "proseWrap": "preserve"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**"]
}
