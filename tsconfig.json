{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "content/skills/**/scripts/**/*.ts"],
  "exclude": ["**/node_modules"]
}
